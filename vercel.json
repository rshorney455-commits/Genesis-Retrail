{
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/claude.js": {
      "maxDuration": 300
    }
  }
}
